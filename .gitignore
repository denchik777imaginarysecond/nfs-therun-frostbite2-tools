# --- Dependencies ---
node_modules/

# --- Outputs, dumps, extracted data ---
output/
extracted/
dumps/
game/
evidence/
*.tsv
*.jsonl
found_strings.txt

# --- Local folders that must never be published ---
# old drafts
_archive/
# third-party binaries (ffmpeg, vgmstream)
tools/
# decompiled third-party code
codes/
# copies of game config files
nfstherun/

# --- Original game files and binaries ---
*.sb
*.toc
*.ebx
*.res
*.chunk
*.cas
*.cat
*.exe
*.dll
*.jar
*.vp6
*.sps

# --- Logs and secrets ---
*.log
npm-debug.log*
.env
.env.*

# --- Local assistant notes / editor / OS ---
CLAUDE.md
.claude/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Modding: mod data comes from the game; patch state and backups live in the game folder ---
mods/
*.bak
fb2_patch_state.json

# --- Packed mods (share them via releases, not the repo) ---
*.nfsmod

# --- Mods saved by the editor (your own work; share the .nfsmod files) ---
my_mods/

# --- Per-user files: the remembered game folder, and the portable Node.js shipped in release zips ---
game_path.txt
node/

# --- Screenshots and pictures dropped into the project folder (never published) ---
/*.png
/*.jpg
/*.jpeg

# --- Car ports: models from other games stay on your PC (never published) ---
my_ports/
/*.glb
